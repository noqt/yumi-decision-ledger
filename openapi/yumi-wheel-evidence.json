      "WheelEvidenceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releases",
          "tags"
        ],
        "properties": {
          "releases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/ReleaseRequest"
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9_]+-[a-z0-9_]+-[a-z0-9_]+$"
            },
            "description": "Canonical lower-case uncompressed interpreter-ABI-platform triples; matching is literal intersection, without compatibility expansion."
          }
        },
        "description": "The implementation requires exactly these two top-level keys. Duplicate normalized project/version pairs are rejected even though that cross-item constraint is not expressible in this schema."
      },
      "ReleaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "version"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]*$"
          }
        }
