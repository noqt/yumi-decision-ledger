{
  "openapi": "3.0.3",
  "info": {
    "title": "Yumi Wheel Evidence",
    "version": "1",
    "description": "Machine-readable description of the existing isolated Yumi Wheel Evidence HTTP surface. This specification describes the existing route only; it does not define a new service, model, relay, or persistence layer. The endpoint accepts public non-secret requests and reports provider-reported PyPI release metadata after filename-tag intersection. It does not assess compatibility, installability, security, origin, digest verification, or artifact availability.",
    "license": {
      "name": "CC0-1.0",
      "url": "https://creativecommons.org/publicdomain/zero/1.0/"
    }
  },
  "externalDocs": {
    "description": "Existing public Yumi Wheel Evidence documentation",
    "url": "https://noqt.no-qt.chatgpt.site/yumi/wheel-evidence"
  },
  "servers": [
    {
      "url": "https://noqt.no-qt.chatgpt.site"
    }
  ],
  "security": [],
  "paths": {
    "/api/yumi/wheel-evidence": {
      "description": "The existing route supports GET, POST, and OPTIONS. HEAD, PUT, PATCH, and DELETE are unsupported and return 405 METHOD_NOT_ALLOWED with an Allow header; they are not advertised as usable capabilities.",
      "get": {
        "operationId": "getWheelEvidenceOrDescriptor",
        "summary": "Return the service descriptor or collect wheel evidence",
        "description": "With no query parameters, returns the service descriptor. Otherwise the query must contain exactly one request parameter and no other keys; its value is UTF-8 JSON subject to the 65,536-byte request limit. Duplicate request parameters are invalid.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "collectWheelEvidence",
        "summary": "Collect wheel evidence for explicit PyPI releases and tags",
        "description": "Accepts only application/json (including parameters such as charset). The body is streamed and capped at 65,536 bytes. If a client supplies Content-Length, the server validates it as an unsigned decimal integer no greater than 65,536; invalid or oversized values map to INVALID_CONTENT_LENGTH or PAYLOAD_TOO_LARGE. Up to two provider release requests are processed concurrently; provider errors remain per-item results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WheelEvidenceRequest"
              },
              "examples": {
                "request": {
                  "value": {
                    "releases": [
                      {
                        "project": "example-package",
                        "version": "1.2.3"
                      }
                    ],
                    "tags": [
                      "cp312-cp312-win_amd64"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CollectSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "options": {
        "operationId": "optionsWheelEvidence",
        "summary": "Return CORS capabilities",
        "responses": {
          "204": {
            "$ref": "#/components/responses/OptionsSuccess"
          }
        }
      }
    }
  },
