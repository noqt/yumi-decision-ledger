  "compatibility_observation": {
    "host": "Codex",
    "environment": "Windows project copy",
    "installer": "skills 1.7.2 --agent codex --copy",
    "python": "3.12.5",
    "observed_result": "The installed resolver and handoff freshness checker worked on fictional data.",
    "integrity_limit": "The installer converted all 12 published LF text files to CRLF. Their LF-normalized content matched, but installed byte hashes differed; manifest SHA-256 values identify the original published LF bytes.",
    "claim_limit": "One compatibility observation for only the named legacy resolver and handoff freshness checker; it does not certify origin_receipt.py, other hosts, independent discovery, or adoption."
  },
  "packaging_boundary": "Version 1.4.0 adds a separate opt-in origin-bound command-receipt capability. Existing ledger components and native skill routing are unchanged. The handoff freshness checker remains v1.2, the snapshot applicability checker remains v1.0, and the resolver and handoff-card base components remain the unchanged already-public Yumi continuity v1.1 capability. Both ledger checkers package and reuse the base components; neither is independent validation. Earlier packaging versions documented native-skill task-fit framing, one observed legacy Codex compatibility check, and native-skill packaging. Immutable base source metadata may retain the earlier noqt/noqt origin documentation URL.",
  "limits": {
    "ledger_input_bytes": 65536,
    "threadmark_output_bytes": 16384,
    "handoff_output_bytes": 4096,
    "required_keys": 8,
    "current_heads": 16,
    "revisions": 128,
    "card_input_bytes": 4096,
    "freshness_check_output_bytes": 16384,
    "snapshot_input_bytes": 65536,
    "snapshot_scope_and_key_length": 256,
    "snapshot_check_output_bytes": 16384,
    "origin_receipt_bytes": 1048576,
    "origin_identity_file_bytes": 10485760,
    "origin_capture_bytes_each_stream": 65536,
    "origin_timeout_seconds": 180,
    "origin_scope_items": 128
  },
  "side_effects": {
    "applies_to_legacy_ledger_components_only": ["yumi_continuity.py", "threadmark_handoff.py", "threadmark_verify.py", "snapshot_check.py"],
    "network": false,
    "telemetry": false,
    "writes_input": false,
    "output_file_mode": false,
    "executes_input_values": false,
    "dereferences_source_ids": false,
    "freshness_check_recomputes_current_threadmark": true,
    "freshness_check_authenticates_card_or_ledger": false,
    "snapshot_check_recomputes_current_threadmark": true,
    "snapshot_check_authenticates_snapshot_or_ledger": false,
    "origin_receipt": {
      "run": {
        "executes_caller_argv_once": true,
        "shell": false,
        "inherits_caller_environment": true,
        "inherits_caller_permissions": true,
        "sandboxed": false,
        "child_network_restriction": false,
        "child_workspace_or_output_write_restriction": false,
        "writes_new_bounded_receipt": true,
        "stores_environment_or_full_transcript": false
      },
      "check": {
        "read_only": true,
        "executes_or_replays_receipt_data": false
      }
    }
  },
  "claim_boundary": "For the legacy ledger components, READY means required-key consistency only within the supplied ledger. UNCHANGED from the handoff checker means the supplied ready card matches a newly resolved supplied ledger; card digest claims remain unauthenticated. UNCHANGED from snapshot_check means only that the supplied scope, exact settings key set, and typed JSON values match the current READY ledger output. The optional origin receipt preserves bounded local command and declared-file identity facts only; caller-declared dependencies may be incomplete, before/after equality does not prove no intermediate change or what the process read, and hashes are not correctness, authentication, permission, external truth, or authority. None of these results establishes safety, task completion, intelligence, adoption, or savings."
}

